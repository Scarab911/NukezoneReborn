// NukezoneReborn — Prisma Schema (Redesign: Turn-Based, Instant Combat)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model Player {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(PLAYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  nation        Nation?
  behaviorScore BehaviorScore?
  bans          Ban[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user Player @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user Player @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model UserProfile {
  id          String   @id @default(cuid())
  playerId    String   @unique
  displayName String
  bio         String?
  honor       Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// WORLD DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model GameWorld {
  id         String      @id @default(cuid())
  name       String      @unique
  status     WorldStatus @default(ACTIVE)
  maxNations Int         @default(1000)
  tickCount  BigInt      @default(0)
  startedAt  DateTime    @default(now())
  endedAt    DateTime?

  nations      Nation[]
  worldEvents  WorldEvent[]
  marketOrders MarketOrder[]
  marketTrades MarketTrade[]
  priceHistory PriceHistory[]
  alliances    Alliance[]
  gameLogs     GameLog[]
  rankings     RankingSnapshot[]
}

// ─────────────────────────────────────────────────────────────────────────────
// NATION DOMAIN — Turn-based, no HP, no map
// ─────────────────────────────────────────────────────────────────────────────

model Nation {
  id          String       @id @default(cuid())
  worldId     String
  playerId    String       @unique
  name        String
  status      NationStatus @default(ACTIVE)
  // Turn system — regenerates 1/5min, max 100
  turns       Int          @default(50)
  maxTurns    Int          @default(100)
  turnsRegenAt DateTime    @default(now())
  // Exploration — tracks how many times land was explored (for diminishing returns)
  explorationCount Int     @default(0)
  // Military
  totalUnits  Int          @default(0)
  color       String       @default("#22c55e")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  world   GameWorld @relation(fields: [worldId], references: [id])
  player  Player    @relation(fields: [playerId], references: [id])

  resource      Resource?
  morale        MoraleRecord?
  bankAccount   BankAccount?
  buildings     Building[]
  armies        Army[]

  attackingBattles  Battle[] @relation("BattleAttacker")
  defendingBattles  Battle[] @relation("BattleDefender")

  spyUnits          SpyUnit[]
  spyOpsInitiated   SpyOperation[] @relation("SpyInitiator")
  spyOpsTargeted    SpyOperation[] @relation("SpyTarget")
  thiefUnits        ThiefUnit[]
  thiefOpsInitiated ThiefOperation[] @relation("ThiefInitiator")
  thiefOpsTargeted  ThiefOperation[] @relation("ThiefTarget")

  researchProjects  ResearchProgress[]
  notifications     Notification[]
  allianceMember    AllianceMember?
  securityEvents    SecurityEvent[]
  sentTransactions      Transaction[] @relation("TxSender")
  receivedTransactions  Transaction[] @relation("TxReceiver")
  upkeepLogs        UpkeepLog[]
  ciRating          CIRating?

  @@index([worldId, status])
  @@index([playerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ECONOMY DOMAIN — Simplified: Money, Land, Population, Energy
// ─────────────────────────────────────────────────────────────────────────────

model Resource {
  id         String   @id @default(cuid())
  nationId   String   @unique
  money      Int      @default(5000)   // primary currency
  land       Int      @default(100)    // territory scale, income base
  energy     Int      @default(200)    // building support
  updatedAt  DateTime @updatedAt
  nation Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)
}

model MoraleRecord {
  id       String @id @default(cuid())
  nationId String @unique
  morale   Int    @default(75)
  nation Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String          @id @default(cuid())
  type      TransactionType
  fromId    String?
  toId      String?
  amount    Int
  resource  String          @default("money")
  note      String?
  createdAt DateTime        @default(now())
  from Nation? @relation("TxSender",   fields: [fromId], references: [id])
  to   Nation? @relation("TxReceiver", fields: [toId],   references: [id])
  @@index([fromId])
  @@index([toId])
  @@index([createdAt])
}

model UpkeepLog {
  id       String   @id @default(cuid())
  nationId String
  goldCost Int
  tickTime DateTime @default(now())
  nation Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)
  @@index([nationId, tickTime])
}

// ─────────────────────────────────────────────────────────────────────────────
// BUILDING DOMAIN — Multiplier-only, consume land
// ─────────────────────────────────────────────────────────────────────────────

model Building {
  id       String       @id @default(cuid())
  nationId String
  type     BuildingType
  count    Int          @default(0)
  nation Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)
  @@unique([nationId, type])
  @@index([nationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BANKING DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model BankAccount {
  id        String   @id @default(cuid())
  nationId  String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  nation       Nation            @relation(fields: [nationId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
  loans        Loan[]
}

model BankTransaction {
  id        String              @id @default(cuid())
  accountId String
  type      BankTransactionType
  amount    Int
  createdAt DateTime            @default(now())
  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId])
}

model Loan {
  id        String     @id @default(cuid())
  accountId String
  principal Int
  remaining Int
  status    LoanStatus @default(ACTIVE)
  takenAt   DateTime   @default(now())
  dueAt     DateTime
  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// MILITARY DOMAIN — Units across Ground/Air/Sea/Special/Strategic
// ─────────────────────────────────────────────────────────────────────────────

model UnitType {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  category     UnitCategory
  attack       Int
  defense      Int
  moneyCost    Int
  upkeep       Int
  requiresTech String?
  sortOrder    Int          @default(0)

  units Unit[]
}

model Army {
  id       String     @id @default(cuid())
  nationId String
  name     String     @default("Army")
  status   ArmyStatus @default(STATIONED)
  nation   Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)
  units    Unit[]
  @@index([nationId])
}

model Unit {
  id         String @id @default(cuid())
  armyId     String
  unitTypeId String
  quantity   Int    @default(0)
  army     Army     @relation(fields: [armyId],     references: [id], onDelete: Cascade)
  unitType UnitType @relation(fields: [unitTypeId], references: [id])
  @@unique([armyId, unitTypeId])
}

model UnitTraining {
  id          String   @id @default(cuid())
  nationId    String
  unitTypeId  String
  quantity    Int
  startedAt   DateTime @default(now())
  completesAt DateTime
  @@index([nationId, completesAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// BATTLE DOMAIN — Instant resolution, no travel time
// ─────────────────────────────────────────────────────────────────────────────

model Battle {
  id               String       @id @default(cuid())
  worldId          String
  attackerNationId String
  defenderNationId String
  type             BattleType   @default(CONVENTIONAL)
  status           BattleStatus @default(RESOLVED)  // always resolved instantly
  winner           String?      // 'ATTACKER' | 'DEFENDER'
  seed             Int
  landGained       Int          @default(0)
  moneyStolen      Int          @default(0)
  turnsCost        Int          @default(1)
  createdAt        DateTime     @default(now())

  attackerNation Nation @relation("BattleAttacker", fields: [attackerNationId], references: [id])
  defenderNation Nation @relation("BattleDefender", fields: [defenderNationId], references: [id])
  report         BattleReport?
  casualties     Casualty[]

  @@index([worldId, attackerNationId])
  @@index([defenderNationId])
}

model BattleReport {
  id        String   @id @default(cuid())
  battleId  String   @unique
  payload   Json
  createdAt DateTime @default(now())
  battle Battle @relation(fields: [battleId], references: [id])
  @@index([createdAt])
}

model Casualty {
  id         String @id @default(cuid())
  battleId   String
  nationId   String
  unitTypeId String
  count      Int
  battle Battle @relation(fields: [battleId], references: [id])
  @@index([battleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MARKET DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model MarketOrder {
  id           String       @id @default(cuid())
  nationId     String
  worldId      String
  side         OrderSide
  resource     ResourceType
  quantity     Int
  pricePerUnit Int
  filledQty    Int          @default(0)
  status       OrderStatus  @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  world GameWorld @relation(fields: [worldId], references: [id])
  @@index([worldId, resource, side, status, pricePerUnit, createdAt])
  @@index([nationId, status])
}

model MarketTrade {
  id          String       @id @default(cuid())
  worldId     String
  buyOrderId  String
  sellOrderId String
  resource    ResourceType
  quantity    Int
  price       Int
  createdAt   DateTime     @default(now())
  world GameWorld @relation(fields: [worldId], references: [id])
  @@index([worldId, resource, createdAt])
}

model PriceHistory {
  id       String       @id @default(cuid())
  worldId  String
  resource ResourceType
  open     Int
  high     Int
  low      Int
  close    Int
  volume   Int
  candleAt DateTime
  world GameWorld @relation(fields: [worldId], references: [id])
  @@unique([worldId, resource, candleAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ALLIANCE DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model Alliance {
  id        String         @id @default(cuid())
  worldId   String
  name      String
  tag       String
  status    AllianceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  world    GameWorld @relation(fields: [worldId], references: [id])
  members  AllianceMember[]
  outboundTreaties AllianceTreaty[] @relation("TreatyOwner")
  inboundTreaties  AllianceTreaty[] @relation("TreatyTarget")
  treasury AllianceTreasury?
  @@index([worldId, status])
}

model AllianceMember {
  id         String       @id @default(cuid())
  allianceId String
  nationId   String       @unique
  role       AllianceRole @default(MEMBER)
  joinedAt   DateTime     @default(now())
  alliance Alliance @relation(fields: [allianceId], references: [id])
  nation   Nation   @relation(fields: [nationId],   references: [id])
}

model AllianceTreaty {
  id               String       @id @default(cuid())
  allianceId       String
  targetAllianceId String?
  type             TreatyType
  status           TreatyStatus @default(PROPOSED)
  proposedAt       DateTime     @default(now())
  acceptedAt       DateTime?
  expiresAt        DateTime?
  alliance       Alliance  @relation("TreatyOwner",  fields: [allianceId],       references: [id])
  targetAlliance Alliance? @relation("TreatyTarget", fields: [targetAllianceId], references: [id])
  @@index([allianceId, status])
}

model AllianceTreasury {
  id         String   @id @default(cuid())
  allianceId String   @unique
  gold       Int      @default(0)
  updatedAt  DateTime @updatedAt
  alliance Alliance @relation(fields: [allianceId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESEARCH DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model TechNode {
  id              String       @id @default(cuid())
  name            String       @unique
  slug            String       @unique
  category        TechCategory
  description     String
  goldCost        Int
  durationSecs    Int
  prerequisiteId  String?
  bonusType       String?
  bonusValue      Float?
  sortOrder       Int          @default(0)
  prerequisite     TechNode?  @relation("TechPrereq", fields: [prerequisiteId], references: [id])
  unlocks          TechNode[] @relation("TechPrereq")
  researchProjects ResearchProgress[]
}

model ResearchProgress {
  id          String         @id @default(cuid())
  nationId    String
  techNodeId  String
  status      ResearchStatus @default(IN_PROGRESS)
  startedAt   DateTime       @default(now())
  completesAt DateTime
  nation   Nation   @relation(fields: [nationId],  references: [id])
  techNode TechNode @relation(fields: [techNodeId], references: [id])
  @@unique([nationId, techNodeId])
  @@index([nationId, status, completesAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ESPIONAGE DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model SpyUnit {
  id                String    @id @default(cuid())
  nationId          String
  skillLevel        Int       @default(1)
  status            SpyStatus @default(IDLE)
  missionsCompleted Int       @default(0)
  createdAt         DateTime  @default(now())
  nation     Nation         @relation(fields: [nationId], references: [id], onDelete: Cascade)
  operations SpyOperation[]
  @@index([nationId, status])
}

model SpyOperation {
  id                String      @id @default(cuid())
  spyUnitId         String
  initiatorNationId String
  targetNationId    String
  type              SpyOpType
  status            SpyOpStatus @default(SCHEDULED)
  scheduledAt       DateTime
  resolvedAt        DateTime?
  success           Boolean?
  detected          Boolean?
  payload           Json?
  spyUnit         SpyUnit @relation(fields: [spyUnitId],         references: [id])
  initiatorNation Nation  @relation("SpyInitiator", fields: [initiatorNationId], references: [id])
  targetNation    Nation  @relation("SpyTarget",    fields: [targetNationId],    references: [id])
  report          SpyReport?
  @@index([status, scheduledAt])
}

model SpyReport {
  id          String    @id @default(cuid())
  operationId String    @unique
  nationId    String
  payload     Json
  read        Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  operation SpyOperation @relation(fields: [operationId], references: [id])
  @@index([nationId, read])
}

model CIRating {
  id        String   @id @default(cuid())
  nationId  String   @unique
  rating    Int      @default(10)
  updatedAt DateTime @updatedAt
  nation Nation @relation(fields: [nationId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// THIEF DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model ThiefUnit {
  id        String      @id @default(cuid())
  nationId  String
  agility   Int         @default(1)
  status    ThiefStatus @default(IDLE)
  createdAt DateTime    @default(now())
  nation     Nation           @relation(fields: [nationId], references: [id], onDelete: Cascade)
  operations ThiefOperation[]
  @@index([nationId, status])
}

model ThiefOperation {
  id                String        @id @default(cuid())
  thiefUnitId       String
  initiatorNationId String
  targetNationId    String
  type              ThiefOpType
  status            ThiefOpStatus @default(SCHEDULED)
  scheduledAt       DateTime
  resolvedAt        DateTime?
  success           Boolean?
  detected          Boolean?
  amountStolen      Int?
  thiefUnit       ThiefUnit @relation(fields: [thiefUnitId], references: [id])
  initiatorNation Nation    @relation("ThiefInitiator", fields: [initiatorNationId], references: [id])
  targetNation    Nation    @relation("ThiefTarget",    fields: [targetNationId],    references: [id])
  @@index([status, scheduledAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  nationId  String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  nation Nation @relation(fields: [nationId], references: [id])
  @@index([nationId, read, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  nationId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  @@index([nationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORLD EVENTS DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model WorldEvent {
  id          String           @id @default(cuid())
  worldId     String
  type        WorldEventType
  status      WorldEventStatus @default(ACTIVE)
  description String
  startedAt   DateTime         @default(now())
  endsAt      DateTime?
  world GameWorld @relation(fields: [worldId], references: [id])
  @@index([worldId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// LEADERBOARD DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model RankingSnapshot {
  id        String   @id @default(cuid())
  worldId   String
  nationId  String
  score     Int
  rank      Int
  snappedAt DateTime @default(now())
  world GameWorld @relation(fields: [worldId], references: [id])
  @@index([worldId, snappedAt])
  @@index([worldId, score])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANTI-CHEAT DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

model BehaviorScore {
  id        String   @id @default(cuid())
  playerId  String   @unique
  score     Int      @default(0)
  signals   Json     @default("[]")
  updatedAt DateTime @updatedAt
  player Player @relation(fields: [playerId], references: [id])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  playerId  String
  nationId  String?
  type      String
  details   Json?
  createdAt DateTime @default(now())
  nation Nation? @relation(fields: [nationId], references: [id])
  @@index([playerId, createdAt])
}

model Ban {
  id        String    @id @default(cuid())
  playerId  String
  action    String
  reason    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  player Player @relation(fields: [playerId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model GameLog {
  id        BigInt   @id @default(autoincrement())
  worldId   String
  eventType String
  payload   Json
  timestamp DateTime @default(now())
  world GameWorld @relation(fields: [worldId], references: [id])
  @@index([worldId, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

enum WorldStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum NationStatus {
  ACTIVE
  PROTECTED
  VACATION
  DESTROYED
}

enum ArmyStatus {
  STATIONED
  MOVING
  IN_BATTLE
}

enum BattleType {
  CONVENTIONAL
  NUCLEAR
  CHEMICAL
  BIOCHEMICAL
  EMP
}

enum BattleStatus {
  PENDING
  RESOLVING
  RESOLVED
  FORCED_DRAW
}

enum BuildingType {
  WAR_FACTORY
  AIRFIELD
  SHIPYARD
  RESEARCH_LAB
  POWER_PLANT
  MISSILE_SILO
  DEFENSE_TOWERS
}

enum UnitCategory {
  GROUND
  AIR
  SEA
  SPECIAL
  STRATEGIC
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

enum ResourceType {
  MONEY
  LAND
  ENERGY
}

enum TransactionType {
  TRANSFER
  LOOT
  ALLIANCE_CONTRIBUTION
  ALLIANCE_DISTRIBUTION
  MARKET_SALE
  MARKET_PURCHASE
  RESEARCH_COST
  TRAINING_COST
  UPKEEP
  BUILDING_COST
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  LOAN_ISSUANCE
  LOAN_REPAYMENT
}

enum LoanStatus {
  ACTIVE
  PAID
  DEFAULTED
}

enum AllianceStatus {
  ACTIVE
  DISBANDED
}

enum AllianceRole {
  LEADER
  OFFICER
  MEMBER
}

enum TreatyType {
  NON_AGGRESSION_PACT
  TRADE_AGREEMENT
  MUTUAL_DEFENSE
  FULL_ALLIANCE
  WAR_DECLARATION
}

enum TreatyStatus {
  PROPOSED
  ACTIVE
  EXPIRED
  BROKEN
  REJECTED
}

enum TechCategory {
  MILITARY
  ECONOMY
  DEFENSE
  ESPIONAGE
  NUCLEAR
}

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SpyStatus {
  IDLE
  ON_MISSION
  CAPTURED
  DEAD
}

enum SpyOpType {
  SCOUT_MILITARY
  SCOUT_ECONOMY
  STEAL_BLUEPRINTS
  SABOTAGE_COMMS
  SABOTAGE_RADAR
  PLANT_MISINFORMATION
  ASSASSINATE_COMMANDER
}

enum SpyOpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  DETECTED
}

enum ThiefStatus {
  IDLE
  ON_OPERATION
  JAILED
  DEAD
}

enum ThiefOpType {
  STEAL_MONEY
  STEAL_LAND
  SABOTAGE_FACTORY
  SABOTAGE_PLANT
  INCITE_RIOT
  ASSASSINATE
}

enum ThiefOpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CAPTURED
}

enum NotificationType {
  INCOMING_ATTACK
  BATTLE_RESOLVED
  SPY_DETECTED
  THIEF_DETECTED
  DIPLOMACY_PROPOSAL
  RESEARCH_COMPLETE
  ALLIANCE_INVITE
  WORLD_EVENT
  NATION_DESTROYED
  STARVATION_WARNING
}

enum WorldEventType {
  NUCLEAR_WINTER
  UN_SANCTIONS
  ARMS_EMBARGO
  ECONOMIC_BOOM
}

enum WorldEventStatus {
  ACTIVE
  ENDED
}
